<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.doom.perspective</groupId>
        <artifactId>doom-perspective-parent</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>doom-perspective-gateway</artifactId>
    <packaging>jar</packaging>

    <name>DOOM Perspective - Gateway</name>

    <dependencies>
        <!-- Common module -->
        <dependency>
            <groupId>com.doom.perspective</groupId>
            <artifactId>doom-perspective-common</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Deliberately NO dependency on headless-renderer.
             gateway.jar must never reference engine classes (mochadoom.*, doom.*,
             com.doom.headless.*, ...) directly; all engine access goes through
             ISessionRunner (common) and the per-session SessionClassLoader.
             Leaving the renderer off the compile classpath makes the compiler
             enforce that rule: an accidental engine import fails the build. -->

        <!-- Ignition SDK -->
        <dependency>
            <groupId>com.inductiveautomation.ignitionsdk</groupId>
            <artifactId>ignition-common</artifactId>
        </dependency>
        <dependency>
            <groupId>com.inductiveautomation.ignitionsdk</groupId>
            <artifactId>gateway-api</artifactId>
        </dependency>

        <!-- Jakarta Servlet API -->
        <dependency>
            <groupId>jakarta.servlet</groupId>
            <artifactId>jakarta.servlet-api</artifactId>
        </dependency>

        <!-- Jetty WebSocket (provided: available in Ignition's Jetty 12.0.15 EE10 runtime) -->
        <dependency>
            <groupId>org.eclipse.jetty.ee10.websocket</groupId>
            <artifactId>jetty-ee10-websocket-jetty-server</artifactId>
            <version>12.0.15</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.eclipse.jetty.websocket</groupId>
            <artifactId>jetty-websocket-jetty-api</artifactId>
            <version>12.0.15</version>
            <scope>provided</scope>
        </dependency>

        <!-- Logging -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>
    </dependencies>

    <build>
        <finalName>gateway</finalName>
    </build>
</project>
